NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Contact form email notifications - sign up at resend.com (use
# triptiagarwal161@gmail.com as the account email so the zero-config
# sandbox sender can send to it with no domain verification needed).
RESEND_API_KEY=

# Visitor analytics write path (app/api/analytics/*) - bypasses RLS,
# so this must ONLY ever be read server-side, never in a Server
# Component/Action or anything a client bundle could reach. Get this
# from the Supabase dashboard: Project Settings > API > service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Protects the nightly retention cron route from being called by
# anyone but Vercel Cron itself - Vercel automatically sends this
# value as a Bearer token when it invokes a scheduled route, once it's
# set as an env var on the project (see vercel.json).
CRON_SECRET=
